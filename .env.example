# AgentFlow Environment Configuration

# LLM Configuration (openai | ollama | mock)
LLM_PROVIDER=mock
OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o-mini

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Database Configuration (PostgreSQL with SQLite fallback)
DATABASE_URL=sqlite+aiosqlite:///./agentflow.db
# For PostgreSQL in Docker: postgresql+asyncpg://postgres:postgres@localhost:5432/agentflow

# Vector Store (ChromaDB)
CHROMADB_DIR=./chroma_db
CHROMADB_COLLECTION=agentflow_docs

# Integration Tokens (Optional)
SLACK_WEBHOOK_URL=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SENDER=

# Observability
LOG_LEVEL=INFO
PROMETHEUS_METRICS_ENABLED=true
